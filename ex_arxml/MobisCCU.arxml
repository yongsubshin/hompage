                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>InitialControllerCheckStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">[DEPRECATED]
The status of checking neighbor controller's version at the CCU initial boot time (3 min)
The value is of the following format and is an uppercase string
&quot;INITIAL&quot;
&quot;CHECKING&quot;
&quot;DONE&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
