Byte #0 : UInt8 evPowerType
Byte #1~#3 : String GENERAL_VEHICLE_CODE
Byte #4~#5 : String GENERAL_VEHICLE_YEAR
Byte #6 : UInt8 TM_SOURCETIME_VALIDITY</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
