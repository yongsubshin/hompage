                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>OTAStatus</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/OTAStatus</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>UnrecognizedRejectReason</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates detailed reason for UnrecognizedReject by HU internal logic.
Format : &quot;001&quot;, &quot;002&quot;, ~ &quot;999&quot; 

//001 : Valet mode
//002 : Force Update
//003 : AVNT OTA
//004 : Power State Change (ACC ON, IGN ON)
//005 : ADM logic off 
//006 : Screen Transition</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>UpdateCheckResult</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Result of the RequestUpdateCheck indicates the value of the latest update information for CCU. The value is of the following format and is an uppercase string. ease refer to the code in the specification for details. 
 
Format : &quot;C1&quot; ~ &quot;C6&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RequestUpdateCheck</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Request to check if there is any latest update information for CCU.
It returns OK/NOK results for metod request. ?Return value : OK, NOK</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
