            <SERVICE-INTERFACE>
              <SHORT-NAME>ProvisioningTable</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>CCU</SHORT-NAME>
                  <SYMBOL>CCU</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Cloud</SHORT-NAME>
                  <SYMBOL>Cloud</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ProvisioningTable</SHORT-NAME>
                  <SYMBOL>ProvisioningTable</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>1</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>CallCenterNumber</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The List of phone numbers the modem accepts for MT Call
    Simply displays the information that received from HeadUnit.
    Permitted Key Lists on Provisioning Table
        AcnOutcallNum
        DTCOutcallNum
        InfoOutcallNum</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>PrivacyOfflineMode</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">GDPR privacy mode status</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ProvisioningStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Last updated service provisioning status from headunit.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ProvisioningStatus</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SMSCenterNumber</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The List of phone numbers the modem accepts for MT SMS
    Simply displays the information that received from HeadUnit.
    Permitted Key Lists on Provisioning Table
        SMSSenderNum
        SMSSenderNum2
        SMSSenderNum3
        AuthSMSNum</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>TimeStamp</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the timestamp when the last provisioning information was updated from headunit.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>ProvisioningTable</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Info</SHORT-NAME>
                  <SYMBOL>Info</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Cloud</SHORT-NAME>
                  <SYMBOL>Cloud</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ProvisioningTable</SHORT-NAME>
                  <SYMBOL>ProvisioningTable</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>3</MAJOR-VERSION>
              <MINOR-VERSION>3</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>CCSBrandName</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field provides the brand name of the connected car service (CCS) in operation.
The language of the brand name is specified by the key, and the value is the name of the CCS in that language.
This key and its associated value provide information about the language that is the same as the language codes and names that are specified in the protocol.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>CallCenterNumber</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The List of phone numbers the modem accepts for MT Call.
Permitted Key Lists on Provisioning Table:
-AcnOutcallNum
-DTCOutcallNum
-InfoOutcallNum</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>DataPlanProducts</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field provides information about the data plan add-on products available for connected car services and their subscription status.
It will be updated whenever the product list or subscription details of the data plan change.
The CCS Server will provide the service code, subscription status, purchase date, and product names.
This ServiceFeatures consists of a ServiceCode attribute, which indicates the availability of each item. 
The list of service features is AUDIO_STANDARD, AUDIO_PREMIUM, VIDEO_PREMIUM, and FEATURE_REARSEAT. 
If the item is supported, the value will be set to &quot;TRUE&quot;, and if not supported, the value will be &quot;FALSE&quot;. 
In the event that the definition of the feature changes in the future, the information in the latest protocol document should be followed.
This ProductNames key and its associated value provide information about the language that is the same as the language codes and names that are specified in the protocol.
This OptionInfos field is reserved for the protocol scalability in the future.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/DataPlanProducts_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Environments</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the information on the service environment.
This field represents the operating environment based on host information in the provisioning table. 
Therefore, it remains independent of manual selection behavior in engineering mode.
When a device is newly provisioned (MO/MT), this field is also updated with the latest information from the server.
If the device is successfully provisioned, the Default value is not available and will be changed to Development/Staging/Production state according to the specification.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/InfrastructureEnvironments</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>EnvironmentsAddress</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This information represents the basic connection information for connecting connections.
Displays the hosts and ports of all hosts in the provisioning table.
It has been defined for convenience from the provisioning table. 
If the table is updated, this information is also updated with re-provisioned information.

Permitted Key Lists on Provisioning Table :
- CCS.host
- CCS.port
- [ANY].host
- [ANY].port</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>OptionInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates items that require optional processing related to vehicle CCS center communication.
When the Headunit needs to selectively process items according to platform classification in CCS communication, it refers to this OptionInfo.
The provisioning table service stores the key-value sets internally.  And stored information is always set in the OptionInfo field.
Permitted Key Lists on OptionInfo
&quot;PubCert-Support&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>PrivacyOfflineMode</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">GDPR privacy mode status</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ProvisioningItems</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the array of provisioning items.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ProvisioningItems_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ProvisioningStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Last updated service provisioning status from headunit.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ProvisioningStatus</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SMSCenterNumber</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The List of phone numbers the modem accepts for MT SMS.
Permitted Key Lists on Provisioning Table
    -SMSSenderNum, -AuthSMSNum</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>TimeStamp</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the timestamp when the last provisioning    information was updated from headunit.    The format is following to &quot;YYYY/MM/DD HH:MM:SS&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>VoLTEMode</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the state of the VoLTE configuration passed from the provisioning table.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetAllProvisioningTable</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method should be implemented using SOME/IP-TP.
    The return result of this method passes the raw value of all provisioning tables in json format.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>json</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SetOptionInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Set the option information related to CCS provisioning and center communication.
The input of KeyInfo values listed in the description of Field OptionInfo item is allowed.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>KeyInfo</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>ValueInfo</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>RFSManager</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Info</SHORT-NAME>
                  <SYMBOL>Info</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Update</SHORT-NAME>
                  <SYMBOL>Update</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>RFSManager</SHORT-NAME>
                  <SYMBOL>RFSManager</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>2</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>ExtractArchiveResult</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides a result of extraction archive status to an external system. 
The Key-Value table follows the specification for each item.

map KeyVale{
    String to String
}
Provides the path and status as below to an external system.

&quot;path&quot; : Extract Path
&quot;status&quot; : Status of extract
&quot;EXTRACTING&quot; : extracting now.
&quot;EXTRACT_COMPETE&quot; : extract complete successfully.
&quot;EXTRACT_FAILED&quot; : it occur fail during extracting.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueMap</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ServerState</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field contains server state to an external system. 

&quot;SERVER_RUNNGING&quot; :  sshfs is running now.
&quot;SERVER_NOT_RUNNING&quot; : sshfs is closed now.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ClearResources</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field contains how to clear resources of the storage.

&quot;CLEAR_ALL&quot; : clear all resources for update.
&quot;CLEAR_SW_PACKAGE&quot; : clear update packages only.
&quot;CLEAR_METADATA&quot; : clear update metadata only.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>Mode</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ExtractArchive</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">If there are multiple archive files, the CCU must request extract sequentially.
ExtractArchive() have a path of the archive file.

&quot;path&quot; : Archive file path</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>Path</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetAvailableSpace</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The available size of the RFS storage is returned in bytes.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>sizeInByte</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int64_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SyncFile</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field contain the path to sync operation of file system of storage after storing resources.

&quot;path&quot; : file path</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>Path</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
