                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>3</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>DataNetRegStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The current Data Registration status of a modem.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RegisterationStatus</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>MCC</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Contains the Mobile Country Code (MCC). This is repeated here for convenience.
    When Remote SIM Provisioning has been performed, the MVNO information (MCC / MNC value) also changed.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>MNC</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Contains the Mobile Network Code (MNC). This is repeated here for convenience.
    When Remote SIM Provisioning has been performed, the MVNO information (MCC / MNC value) also changed.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Name</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Contains the current operator name,
                    suitable for display on the idle screen or an empty string
                    if not registered to a network.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SignalStrengthGSM</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Field for the signal metrics measured on GSM network
    This field is valid only if SignalStrengtType is TYPE_GSM
    and if SignalStrengtType is not TYPE_GSM type, the value for all field filled are invalid.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SignalStrengthGSM</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SignalStrengthLTE</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Field for the signal metrics measured on LTE network.
    This field is valid only if SignalStrengtType is TYPE_LTE. 
    and if SignalStrengtType is not TYPE_LTE type, the value for all field filled are invalid.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SignalStrengthLTE</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SignalStrengthType</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Contains the Radio Access Technology of the signal metrics.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SignalStrengthType</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SignalStrengthWCDMA</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Field for the signal metrics measured on WCDMA network.
