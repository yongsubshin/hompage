                  <SYMBOL>Vehicle</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>IPCHandler</SHORT-NAME>
                  <SYMBOL>IPCHandler</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>RoutingIPC</SHORT-NAME>
                  <SYMBOL>RoutingIPC</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>3</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>EventMcuLogData</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/EventMcuLogData_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>EventNSDResetData</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/EventNSDResetData_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>EventNonSleepEcuIdx</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/EventNonSleepEcuIdx_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>EventPbsFirstWk</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">PBS 모드 에서 각 채널별 T_WaitBusSleep 시간동안 머무는 동안 최초 Wakeup 제어기 발생시 NSD 로 Trigger 신호 전달
0x0 : Default
0x1 : B1 채널
0x2 : B2 채널
0x3 : M 채널
0x4 : P1 채널
0x5 : P2 채널
0x6 : C 채널
0x7 : E 채널
0x8 : I 채널</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/EventPbsFirstWk_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>PeriodicSystemInfo</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/PeriodicSystemInfo_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>PeriodicSystemInfoAdditional</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">MCU -> AP 전달되는 시스템 정보 중 Periodic 또는 Periodic &amp; Event 타입 데이터 전달을 위한 api / 하위호환 유지를 위한 Additional IF
Byte #0 : MCU CPU Load (%)
Byte #1 : LLCE Core Load PPE TX (%)
Byte #2 : LLCE Core Load PPE RX (%)
Byte #3 : LLCE Core Load DTE (%)
Byte #4 : LLCE Core Load FRPE (%)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/PeriodicSystemInfoAdditional_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>EventSystemInfo</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/EventSysInfo</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>EventSystemInfoAdditional</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">MCU -> AP 전달되는 시스템 정보 중 Event 타입 데이터 전달을 위한 api / 하위호환 유지를 위한 Additional IF
Byte #0 : NM_STATUS_B1
Byte #1 : NM_STATUS_B2
Byte #2 : NM_STATUS_M
Byte #3 : NM_STATUS_P1
Byte #4 : NM_STATUS_P2
Byte #5 : NM_STATUS_C
Byte #6 : NM_STATUS_E
Byte #7 : NM_STATUS_I
Byte #8 : NM_STATUS_ETH
Byte #9 : REMOTE_WU_B1
Byte #10 : REMOTE_WU_B2
Byte #11 : REMOTE_WU_M
Byte #12 : REMOTE_WU_P1
Byte #13 : REMOTE_WU_P2
Byte #14 : REMOTE_WU_C
Byte #15 : REMOTE_WU_E
Byte #16 : REMOTE_WU_I
Byte #17 : REMOTE_WU_ETH
Byte #18 : PNC Activated Event
Byte #19 : CAN Bus
Byte #20 : INH_B1
Byte #21 : INH_B2
Byte #22 : INH_M
Byte #23 : INH_D

NM_STATUS Value:
0:Default
1:NM_RMS_BSM
2:NM_RMS_PBSM
3:RESERVED
4:NM_NS_RMS
5~0x7:RESERVED
8:NM_NS_RSS
9~15:RESERVED
16:NM_RMS_RSS
17~31:RESERVED
32:NM_RMS_NS
33~255:RESERVED

REMOTE_WU Value :
0: Not Received
1: Received

PNC Activated Event, CAN Bus INH Value : 
0: Low
1: High</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteArray</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>TwaitBusSleepTime</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">ASM이 EngineeringMode를 통해 NVM의 TwaitBusSleepTime를 Read/Write 대응하는 I/F</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>false</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ASMInfoRequest</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">ASM -> TM 시간 정보 전달 요청 전송</L-2>
                  </DESC>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetOneTimeSystemInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">MCU -> AP 전달되는 시스템 정보 중 1회만 전달하면 되는 데이터 전달을 위한 api</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>info</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/OneTimeSysInfo</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetOneTimeSystemInfoAdditional</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">MCU -> AP 전달되는 시스템 정보 중 1회만 전달하면 되는 데이터 전달을 위한 api / 하위호환 유지를 위한 Additional IF
Byte #0 : UInt8 evPowerType
Byte #1~#3 : String GENERAL_VEHICLE_CODE
Byte #4~#5 : String GENERAL_VEHICLE_YEAR
Byte #6 : UInt8 TM_SOURCETIME_VALIDITY</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>sysInfo</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteArray</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetRdbCheckValue</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">provide RDB table value to check each channel rdb receving info for Non Sleep Detection</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>rdbTable</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint16_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetRtcWakeupTimer</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">get the Timer value for presetTimer and currentCountTimer.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>timer</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Timer</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>err</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
