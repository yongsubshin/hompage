                      <DESC>
                        <L-2 L="KO">a unique identifier for the software release</L-2>
                      </DESC>
                      <TYPE-REFERENCE>
                        <INPLACE>false</INPLACE>
                        <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-REFERENCE-REF>
