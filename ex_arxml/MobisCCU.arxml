                  <SHORT-NAME>StopRtcWakeupTimer</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">stop rtc wakeup timer</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>err</SHORT-NAME>
