              <FIELDS>
                <FIELD>
                  <SHORT-NAME>DEVInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides metadata for recorded driving event video and its status.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/DEVInfo_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>FinishTransmitting</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Notifies that the transmission of the corresponding driving event video has been completed.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>eventID</SHORT-NAME>
