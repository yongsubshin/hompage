                      <SHORT-NAME>response</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SysCtrlResp</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TriggerApHeartbeat</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">IPC → PM으로 AP_HEARTBEAT 송신</L-2>
                  </DESC>
                  <FIRE-AND-FORGET>true</FIRE-AND-FORGET>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TriggerSelfUpdateHeartbeat</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">IPC → PM으로 SELF_UPDATE_HEARTBEAT 송신</L-2>
                  </DESC>
                  <FIRE-AND-FORGET>true</FIRE-AND-FORGET>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Update_IVP_Info</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">IVP 완료 되어 SecOC key update 되었음을 MCU에 전달.
IVP success(info1), fail(info2) event 개수를 MCU에 전달</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>infoType</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/IVPInfoType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>info1</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>info2</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/IVPErrorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>RoutingTP</SHORT-NAME>
