            <SERVICE-INTERFACE>
              <SHORT-NAME>Logging</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Vehicle</SHORT-NAME>
                  <SYMBOL>Vehicle</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>LogCollection</SHORT-NAME>
                  <SYMBOL>LogCollection</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>StartLogging</SHORT-NAME>
                  <SYMBOL>StartLogging</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>2</MINOR-VERSION>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ControlCANStreamingRT</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Control CAN Streaming RealTime / False : Off, True : On</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>onOff</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>option</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ControlCanStreaming</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">LogCollection이 CAN 로그 파일을 eMMC에 실시간 저장할 수 있도록 요청하는 메소드
action 0 : Stop, 1 : Start</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>appId</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>action</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>timeout_min</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int8_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>retVal</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int8_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>StartLogging</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>appId</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>option</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">0: ETH/CAN off, 1: ETH only, 2: CAN only, 3: BOTH</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int8_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>retVal</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">0: OK, 1: GENERAL_FAILURE</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int8_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>StopLogging</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>appId</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>retVal</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">0: OK, 1: GENERAL_FAILURE</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int8_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>MQTT</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Vehicle</SHORT-NAME>
                  <SYMBOL>Vehicle</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Telemanager</SHORT-NAME>
                  <SYMBOL>Telemanager</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>MQTT</SHORT-NAME>
                  <SYMBOL>MQTT</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>MqttRequestStatus</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MqttRequestStatus_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>TopicMessage</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TopicMessage_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>TopicMessageV5</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TopicMessageV5_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>ConnectionState</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/CCConnectionState</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetExtraPropertyInfo</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>result</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/CCResult</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
