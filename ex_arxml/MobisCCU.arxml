            <SERVICE-INTERFACE>
              <SHORT-NAME>UpdateRequest</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ara</SHORT-NAME>
                  <SYMBOL>ara</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>sm</SHORT-NAME>
                  <SYMBOL>sm</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>PrepareRollback</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Has to be called by Update And Configuration Management after State Management allowed to update.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>FunctionGroupList</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/FunctionGroupList</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/Rejected</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/RollbackFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>PrepareUpdate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Has to be called by Update And Configuration Management after State Management allowed to update. State Management will decline this request when StartUpdateSession was not called before successfully.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>FunctionGroupList</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/FunctionGroupList</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/PrepareFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/Rejected</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ResetMachine</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Requests a reset of the machine. Before the reset is performed all information within the machine shall be persisted. Request will be rejected when StartUpdateSession was not called successfully before.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/Rejected</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>StartUpdateSession</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Has to be called by Update And Configuration Management once it has to start interaction with State Management. State Management might decline this request when machine is not in a state to be updated.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/Rejected</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>StopUpdateSession</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Has to be called by Update And Configuration Management once the update is finished to let State Managemen know that update is done and Machine is in a stable state. Request will be rejected when StartUpdateSession was not called successfully before.</L-2>
                  </DESC>
                  <FIRE-AND-FORGET>true</FIRE-AND-FORGET>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>VerifyUpdate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Has to be called by Update And Configuration Management after State Management allowed to update and the update preparation has been done. State Management will decline this request when Prepare Update was not called before successfully.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>FunctionGroupList</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/FunctionGroupList</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/Rejected</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/VerifyFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>UpdateStandard</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Update</SHORT-NAME>
                  <SYMBOL>Update</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>USS</SHORT-NAME>
                  <SYMBOL>USS</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>UpdateStandard</SHORT-NAME>
                  <SYMBOL>UpdateStandard</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>2</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>CureentSDSAuthenticationLevel</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">[NE1aW] SDS 인증 대응용 API / Inform when SDS Authentication is changed
userRole bitmask:
Bit 0: Default/Anybody
Bit 1: OEM servicing
Bit 2: enhanced
Bit 3: operations
Bit 4: basic
Bit 5: All functional
Bit 6: Rollback
Bit 7: reserved

diagRoutingRole bitmask:
Bit 0: Onboard DoIP (SDS)
Bit 1: Offboard DoIP (ERT)
Bit 2: Diagnostics CAN (EDT)
Bit 3: Disable Flooding protection
Bit 4: Airbag deployment (CCU 미사용)
Bit 5~7: reserved</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/CertRole</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
