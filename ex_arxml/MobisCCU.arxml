                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>MSM</SHORT-NAME>
                  <SYMBOL>MSM</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ModemManager</SHORT-NAME>
                  <SYMBOL>ModemManager</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>IMEI</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
