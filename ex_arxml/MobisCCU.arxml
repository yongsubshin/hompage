                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>types</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ChangeIVNRule_types_VECTOR</TYPE-TREF>
