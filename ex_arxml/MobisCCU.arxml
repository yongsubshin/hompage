              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>4</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>DiagRoutingActiveInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">[NE1aW] SDS로 부터 수신한 SecOC 진단 라우팅 활성화 정보를 전달하는 api
MCU -> IPCH(AP) -> ApSysMgr : Field Setter
ApSysMgr -> DiagMgr : Field Notifier

1 Byte bitmask : 
Bit 0: On-Board active (SDS)
Bit 1: Off-Board active (ERT)
Bit 2: Diagnostics CAN (EDT)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SecureAccessActiveInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">True : Active
False : Inactive</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ControlLogLevel</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">WDBI DID $12b1과 매핑,
App 별 log level control을 위한 api

Log Level 값
0x00 : kOff, 0x01 : kFatal, 0x02 : kError, 0x03 : kWarn
0x04 : kInfo, 0x05 : kDebug, 0x06 : kVerbose, 0x07~0xFE : Reserved, 0xFF : 초기 상태

err mapping
Busy : ASM 부하 상황
FAIL : Json 파일 open 실패 등 파일 Wrtie 실패 시</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>appId</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>logLevel</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>err</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Error</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
