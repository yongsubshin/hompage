                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>PackageManagement</SHORT-NAME>
                  <SYMBOL>PackageManagement</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>2</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>CurrentStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The current status of UCM.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/PackageManagerStatusType</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>RollbackResult</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The result of rollback</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RollbackResultType</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Activate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method activates the processed components.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ActivatingUpdateFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/LowerVersionDownloadAttempt</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/MissingDependencies</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/PreActivationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/UpdateSessionRejected</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/VerificationFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Cancel</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method aborts an ongoing processing of a Software Package.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The Transfer ID.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/CancelFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>DeleteTransfer</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Delete a transferred Software Package.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Transfer ID of the currently running request.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Finish</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method finishes the processing for the current set of processed Software Packages. It does a cleanup of all data of the processing including the sources of the Software Packages.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SyncAbFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetAppIVDHash</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Application S/W의 IVD Hash를 structure vector 형태로 전달</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>appIVDHash</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/AppIVDHashVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetHistory</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Getter method to retrieve all actions that have been performed by UCM.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>timestampGE</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Earliest timestamp (inclusive)</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint64_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>timestampLT</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Latest timestamp (exclusive)</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint64_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>history</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The history of all actions that have been performed by UCM.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/GetHistoryVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetId</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Get the UCM Instance Identifier.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">UCM Module Instantiation Identifier.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/UCMIdentifierType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwClusterChangeInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method returns a list pending changes to the set of SoftwareClusters on the adaptive platform. The returned list includes all SoftwareClusters that are to be added updated or removed. The list of changes is extended in the course of processing Software Packages.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>SwInfo</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">List of SoftwareClusters that are in state kAdded kUpdated or kRemoved.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SwClusterInfoVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwClusterDescription</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method returns the general information of the Software Clusters present in the platform</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>SwCluster</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">List of SoftwareClusters present in the platform.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SwDescVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwClusterInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method returns a list of SoftwareClusters that are in state kPresent</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>SwInfo</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">List of installed SoftwareClusters that are in state kPresent.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SwClusterInfoVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwPackages</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method returns the Software Packages that available in UCM.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>Packages</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">List of Software Packages.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SwPackageInfoVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwProcessProgress</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Get the progress (0 - 100%) of the currently processed Software Package.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The Transfer ID of the Software Package.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>progress</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The progress of the current package processing (0% - 100%). 0x00 ... 0x64 0xFF for &quot;’No information available&quot;’</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Initialize</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Remove all the software packages and transfer to Idle state.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InitializeFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ProcessSwPackage</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Process a previously transferred Software Package.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The Transfer ID of the Software Package which should be processed.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/AlreadyInstalledVersion</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/AuthenticationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncompatibleDelta</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncompatiblePackageVersion</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientComputationPower</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidPackageManifest</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ProcessSwPackageCancelled</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ProcessedSoftwarePackageInconsistent</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityError</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ServiceBusy</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SourceVerificationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/StartSelfUpdateFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/TargetVerificationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/UpdateError</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RemoveAppSwPackage</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Application S/W의 삭제 요청</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>AppID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/RemoveSwPackageFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RevertProcessedSwPackages</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Revert the changes done by processing (ProcessSwPackage) of one or several software packages.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/NotAbleToRevertPackages</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/RevertUpdateFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Rollback</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Rollback the system to the state before the packages were processed.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/LowerVersionDownloadAttempt</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/NotAbleToRollback</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/RollingbackUpdateFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferData</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Block-wise transfer of a Software Package to UCM.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Transfer ID.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>data</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Data block of the Software Package.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteVectorType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>blockCounter</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Block counter value of the current block.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint64_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/AuthenticationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/BlockInconsistent</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncompatiblePackageVersion</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncorrectBlock</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncorrectBlockSize</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncorrectSize</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientComputationPower</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/PackageInconsistent</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/TransferInterrupted</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferExit</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Finish the transfer of a Software Package to UCM.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Transfer ID of the currently running request.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/AuthenticationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncompatiblePackageVersion</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientData</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidPackageManifest</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/MissingDependencies</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OldVersion</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/PackageInconsistent</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferFilePath</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Software Package가 위치한 File Path를 전달</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Transfer ID of the currently running request.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>FilePath</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">FilePath</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidFilePath</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/PackageInconsistent</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferStart</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Start the transfer of a Software Package. The size of the Software Package to be transferred to UCM must be provided. UCM will generate a Transfer ID for subsequent calls to TransferData TransferExit ProcessSwPackage DeleteTransfer.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>size</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Size (in bytes) of the Software Package to be transferred.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint64_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Return TransferId.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>BlockSize</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Size of the blocks to be received with TransferData method.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientComputationPower</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>PackageManagement</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ara</SHORT-NAME>
                  <SYMBOL>ara</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ucm</SHORT-NAME>
                  <SYMBOL>ucm</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>pkgmgr</SHORT-NAME>
                  <SYMBOL>pkgmgr</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>3</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>CurrentStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The current status of UCM.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/PackageManagerStatusType</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>PreInstallRequiredAppsInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">notify preinstall app to UpdateMaster</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/PreInstallAppInfoVectorType</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>RollbackResult</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The result of rollback</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RollbackResultType</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Activate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method activates the processed components.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ActivatingUpdateFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/LowerVersionDownloadAttempt</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/MissingDependencies</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/PreActivationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/UpdateSessionRejected</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/VerificationFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Cancel</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method aborts an ongoing processing of a Software Package.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The Transfer ID.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/CancelFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>DeleteTransfer</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Delete a transferred Software Package.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Transfer ID of the currently running request.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Finish</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method finishes the processing for the current set of processed Software Packages. It does a cleanup of all data of the processing including the sources of the Software Packages.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SyncAbFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetAppIVDHash</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Application S/W의 IVD Hash를 structure vector 형태로 전달</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>appIVDHash</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/AppIVDHashVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetHistory</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Getter method to retrieve all actions that have been performed by UCM.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>timestampGE</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Earliest timestamp (inclusive)</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint64_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>timestampLT</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Latest timestamp (exclusive)</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint64_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>history</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The history of all actions that have been performed by UCM.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/GetHistoryVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetId</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Get the UCM Instance Identifier.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">UCM Module Instantiation Identifier.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/UCMIdentifierType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwClusterChangeInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method returns a list pending changes to the set of SoftwareClusters on the adaptive platform. The returned list includes all SoftwareClusters that are to be added updated or removed. The list of changes is extended in the course of processing Software Packages.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>SwInfo</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">List of SoftwareClusters that are in state kAdded kUpdated or kRemoved.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SwClusterInfoVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwClusterDescription</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method returns the general information of the Software Clusters present in the platform</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>SwCluster</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">List of SoftwareClusters present in the platform.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SwDescVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwClusterInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method returns a list of SoftwareClusters that are in state kPresent</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>SwInfo</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">List of installed SoftwareClusters that are in state kPresent.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SwClusterInfoVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwPackages</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method returns the Software Packages that available in UCM.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>Packages</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">List of Software Packages.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SwPackageInfoVectorType</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetSwProcessProgress</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Get the progress (0 - 100%) of the currently processed Software Package.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The Transfer ID of the Software Package.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>progress</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The progress of the current package processing (0% - 100%). 0x00 ... 0x64 0xFF for &quot;’No information available&quot;’</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Initialize</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Remove all the software packages and transfer to Idle state.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InitializeFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ProcessSwPackage</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Process a previously transferred Software Package.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">The Transfer ID of the Software Package which should be processed.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/AlreadyInstalledVersion</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/AuthenticationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncompatibleDelta</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncompatiblePackageVersion</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientComputationPower</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidPackageManifest</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ProcessSwPackageCancelled</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ProcessedSoftwarePackageInconsistent</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityError</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ServiceBusy</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SourceVerificationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/StartSelfUpdateFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/TargetVerificationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/UpdateError</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RemoveAppSwPackage</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Application S/W의 삭제 요청</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>AppID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/RemoveSwPackageFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RequestRDBI</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">SelfDiag 중 UCM에서 처리하는 데이터를 얻기 위한 범용적 RDBI method</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>DID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint16_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>ack</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>res</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteArray</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/RequestRDBIFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RevertProcessedSwPackages</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Revert the changes done by processing (ProcessSwPackage) of one or several software packages.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/NotAbleToRevertPackages</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/RevertUpdateFailed</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Rollback</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Rollback the system to the state before the packages were processed.</L-2>
                  </DESC>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/LowerVersionDownloadAttempt</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/NotAbleToRollback</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/RollingbackUpdateFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferData</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Block-wise transfer of a Software Package to UCM.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Transfer ID.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>data</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Data block of the Software Package.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteVectorType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>blockCounter</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Block counter value of the current block.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint64_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-AP-ERROR-REFS>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/AuthenticationFailed</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/BlockInconsistent</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncompatiblePackageVersion</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncorrectBlock</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncorrectBlockSize</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/IncorrectSize</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientComputationPower</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/PackageInconsistent</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/TransferInterrupted</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferExit</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Finish the transfer of a Software Package to UCM.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>id</SHORT-NAME>
                      <DESC>
                        <L-2 L="KO">Transfer ID of the currently running request.</L-2>
                      </DESC>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferIdType</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
