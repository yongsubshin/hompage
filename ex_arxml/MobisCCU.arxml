                  <SYMBOL>Vehicle</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Telemanager</SHORT-NAME>
                  <SYMBOL>Telemanager</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Communicator</SHORT-NAME>
                  <SYMBOL>Communicator</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>PrivacyOfflineMode</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>Communicator</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>CCU</SHORT-NAME>
                  <SYMBOL>CCU</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Cloud</SHORT-NAME>
                  <SYMBOL>Cloud</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Communicator</SHORT-NAME>
                  <SYMBOL>Communicator</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>MORequestChanged</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This event indicates that a MO Request status has been changed.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MORequestChanged_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>MTRequestAdded</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This event indicates that a new CCS MT request has been received and stored into queue.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MTRequestAdded_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>MTRequestRemoved</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This event indicates that a CCS MT request has been removed from the task queue.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MTRequestRemoved_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>LastActiveUser</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Leave the last remote control user's information.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>MTRequestQueue</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The CCS service request for the HeadUnit is converted to a struct CCSRequest object and that will be listed in the Received Item.
    ServiceName : Destination Service Name (Reserved Field)
    TimeStamp : &quot;2020-09-10 10:20:30.0&quot;
    MSGID : Timestamp in which a 4byte integer is expressed in characters. However, If sending/receiving with SMS+ scheme, MSGID field is used for MSGID(4Byte) of SMS.
    TransactionID: Transaction ID is assigned by the server
    Scheme : CCS Protocol Scheme of CCS Request Object. (HTTP+, SMS+)
    Status : Processing status of CCS Request Object, Initial status is Idle.
    Message : Received Message Object</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MTRequestQueue_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>ProcessMTRequest</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Endpoint ECU informs to CCU that a struct CCSRequest object is being processing. And the CCU changes the status of the message to processing.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>transactionID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ProcessMTRequestError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>status</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MTMessageStatus</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RemoveMTRequest</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The Endpoint ECU requests that the MT request was processed by Communicator and that the request be automatically deleted.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>transactionID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RemoveMTRequestError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SendMORequest</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Send a message to recipient. Send Result will be reported by MORequestChanged event.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>item</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/CCSRequest</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MessageError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>msgID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>ConnectionContext</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>DCU</SHORT-NAME>
                  <SYMBOL>DCU</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Telephony</SHORT-NAME>
                  <SYMBOL>Telephony</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ConnectionContext</SHORT-NAME>
                  <SYMBOL>ConnectionContext</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>1</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>AccessPointName</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Holds the name of the access point.
    This is abbreviated as APN.
    This value cannot be changed when the context is active.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>AutoConnect</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">To improve remote control service time, DCU will activate data connection when receiving SMS from center on remoted service mode (336h remote control mode).  For this, CCU should send CCS APN for remote control service on every booting time.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ContextIndex</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Holds the Context Index for this Connection Context.
    This Context Index is for managing and transferring connections into the in vehicle network from outer network.
    Internally, the telephony service provides VLAN IDs and regarding network information following to network specifications by Context Index.
    Example network configuration for
    -ContextIndex : CONTEXT_INDEX_0
    -VLANID : 0x803 (2051)
    -Interface : eth0.2051
    -Address : 192.168.220.8
    -RemoteAddress : 192.168.220.4
    -Netmask : 255.255.255.0</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextIndex</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ContextPath</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Holds the ContextPath is a self-rule-based string type object path that the telephony middleware generates on its own when it ContextAdded.
    Each modem manufacturer can have a different generation rule.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>DeactivateReason</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Deactivate data call reasons</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/DeactivateReason</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IPV6_Settings_Address</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the IP address assigned to the context.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IPV6_Settings_DomainNameServers</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the list of domain name servers assigned to the context.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/IPV6_Settings_DomainNameServers_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IPV6_Settings_Gateway</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the gateway for this connection.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IPV6_Settings_Interface</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the network interface name assigned to the context. (e.g. &quot;rmnet0&quot;)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IPV6_Settings_PrefixLength</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the prefix length assigned to the context.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IVN_Settings_Address</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The network interface information in the Internal VLAN Network's direction.
    This information is determined by the modem after context activation.
    Holds the local IP address.
    Examples local IP address for CCU-DCU network topology
    VLAN 0x803(2051) → 192.168.220.8
    VLAN 0x804(2052) → 192.168.221.8
    VLAN 0x805(2053) → 192.168.221.8
    VLAN 0x806(2054) → 192.168.221.8</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IVN_Settings_Interface</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The network interface information in the Internal VLAN Network's direction.
    This information is determined by the modem after context activation.
    Holds the local network interface name for internal forwarding network domain.
    Examples for local network interface name.
    &quot;eth0.2051&quot;, &quot;eth0.2052&quot;, &quot;eth0.2053&quot;, &quot;eth0.2054&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IVN_Settings_Netmask</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The network interface information in the Internal VLAN Network's direction.
    This information is determined by the modem after context activation.
    Holds the netmask for local-remote network.
    Examples for Subnet Mask : 255.255.255.0</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IVN_Settings_RemoteAddress</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The network interface information in the Internal VLAN Network's direction.
    This information is determined by the modem after context activation.
    Holds the remote IP address.
    Examples remote IP address value for CCU-DCU network topology
    VLAN 0x803(2051) → 192.168.220.4
    VLAN 0x804(2052) → 192.168.221.4
    VLAN 0x805(2053) → 192.168.221.4
    VLAN 0x806(2054) → 192.168.221.4</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>IVN_Settings_VLANID</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The network interface information in the Internal VLAN Network's direction.
    This information is determined by the modem after context activation.
    Holds the VLAN ID for internal forwarding network domain.
    Examples for CCU-DCU external network connection
    0x803(2051), 0x804(2052), 0x805(2053), 0x806(2054)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Name</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The name is a free form string that describes this context.
    The name should not be empty and limited to a short string for display purposes.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Password</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Holds the password to be used for authentication purposes.
    his value cannot be changed when the context is active.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Protocol</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Holds the protocol for this context.
    Valid values are: &quot;ip&quot;, &quot;ipv6&quot; and &quot;dual&quot;.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Settings_Address</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the IP address assigned to the context.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Settings_DomainNameServers</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction.
    This information is determined by the modem after context activation. 
    Holds the list of domain name servers assigned to the context.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Settings_DomainNameServers_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Settings_Gateway</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the gateway for this connection.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Settings_Interface</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    This means that regarding network resources can be changed during the activation process. 
    Holds the network interface name assigned to the context. (e.g. &quot;rmnet0&quot;)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Settings_Method</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    Holds the network interface config methods assigned to the context.
    &quot;static&quot;- Set IP network statically
    &quot;dhcp&quot; - Set IP network through DHCP</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Settings_Netmask</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the netmask assigned to the context.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Settings_Proxy</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The external network interface information in the network operator's direction. 
    This information is determined by the modem after context activation. 
    Holds the proxy for this connection.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Status</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Holds the status of Connection Context</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextStatus</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Type</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Contains the intended usage type for this context.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Username</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Holds the username to be used for authentication purposes.
    This value cannot be changed when the context is active.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>true</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Activate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Activate PDP Context Request.
    The network resources in the external interface(Field Settings, IPv6_Settings) is determined by the modem after context activation.
    The network resources in the external interface area is determined by the modem after context activation.
    The remote peer should always consider that network resources can access after external network is activated.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Deactivate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Deactivate PDP Context Request</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SetContextIndex</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Request to changing the ContextIndex from the default assigned context index.
    The ContextIndex value to be setted is must be that is not used elsewhere instance. In this conflicted case will return to Error &quot;DuplicatedIndex&quot;. 
    Of course, the value of CONTEXT_INVALID is not available.
    The ContextIndex value changing is not allowed in a Post-Activate state. In this state error case will return to Error &quot;InvalidStatus&quot;.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>index</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextIndex</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetContextIndexError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>ConnectionManager</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>DCU</SHORT-NAME>
                  <SYMBOL>DCU</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Telephony</SHORT-NAME>
                  <SYMBOL>Telephony</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ConnectionManager</SHORT-NAME>
                  <SYMBOL>ConnectionManager</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>ContextAdded</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This event indicates that the ConnectionContext has added.
    The ContextPath is a self-rule-based string type object path that the telephony middleware generates on its own when it ContextAdded.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextAdded_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>ContextRemoved</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This event indicates that the ConnectionContext has removed</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextRemoved_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>AddContext</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Request to creating a new connection context.
    Input argument AccessPointName is used for specify &quot;Access Point Name&quot; that you want to activate through this Connection Context.
    Input argument Protocol is used for specify ip mode that you want to activate.
    Valid values for Protocol is &quot;ip&quot;, &quot;ipv6&quot; and &quot;dual&quot;
    Output argument ContextPath is a self-rule-based string type object path that the telephony middleware generates on its own when it ContextAdded.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>accessPointName</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>protocol</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/AddContextError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>contextPath</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>DeactivateAll</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Deactivates all active contexts</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetContext</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Gets the registered connection context wite ContextID on the modem.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>contextPath</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/GetContextError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>item</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ConnectionContextItem</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetContexts</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Gets the registered connection contexts on the modem.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>items</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/GetContexts_items_VECTOR</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RemoveContext</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Request to remove a existing connection context. 
    When an object is removed, the ContextIndex value is changed to CONTEXT_INVALID and regarding properties are also cleared.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>contextPath</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RemoveContextError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>DataCollection</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Vehicle</SHORT-NAME>
                  <SYMBOL>Vehicle</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>SOAAdaptor</SHORT-NAME>
                  <SYMBOL>SOAAdaptor</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>DataCollection</SHORT-NAME>
                  <SYMBOL>DataCollection</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>CapturedMessages</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">[SOME/IP-TP] Events to notify captured messages.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/CapturedMessages_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
