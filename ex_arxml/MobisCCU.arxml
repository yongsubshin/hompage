                    <L-2 L="KO">This event requests to remove stored MessageItem in DCU</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>msgID</SHORT-NAME>
