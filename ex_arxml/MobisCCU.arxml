                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/SecurityAccessDenied</POSSIBLE-AP-ERROR-REF>
                  </POSSIBLE-AP-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
