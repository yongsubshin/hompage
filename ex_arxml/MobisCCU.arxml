                  <SYMBOL>BltnCam</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>System</SHORT-NAME>
                  <SYMBOL>System</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Manager</SHORT-NAME>
                  <SYMBOL>Manager</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>1</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>FrontIspConfigInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the front camera ISP configuration version of the built-in cam system. 
Front camera ISP configuration Version Example
: &quot;01.02.03.04&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>FrontIspFwInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the front camera ISP Firmware version of the built-in cam system. 
Front camera ISP Firmware Version Example
: &quot;0D.00.00.01&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>HwInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the hardware version of the built-in cam system. 
HW Version Example
: “D.00&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>OtherInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the other information of the built-in cam system. 
Other information Example
: &quot;SDK : LV20-5p1-R8, InfoUpdateProcess : 4.02, BltnCamCameraInfoManager : 1.0, BltnCamParkingEventManager 3.0&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>PlatformInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the platform version of the built-in cam system. 
Platform Version Example
: “BLTN_CAM_2.0&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>PlatformSwInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the platform software version of the built-in cam system. 
Platform SW Version Example
: “1.00&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>RearIspConfigInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the rear camera ISP configuration version of the built-in cam system. 
Rear camera ISP configuration Version Example
: &quot;01.02.03.04&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>RearIspFwInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the rear camera ISP Firmware version of the built-in cam system. 
Rear camera ISP Firmware Version  Version Example
: &quot;0D.00.00.01&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Region</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the region of the built-in cam system. 
Region Example
: “KOR&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Status</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides operational status of the built-in cam system.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/BltnCamStatus</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SwBuildDate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the software build date of the built-in cam system. 
Software build date Example
: “20220826&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SwInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the software version of the built-in cam system. 
-Use-Case : DIM-C, Whenever IGN is turned on, S/W Version infomations should be collected and uploaded. 
-SW Version Example : &quot;01.02.03.04&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SwInfoMcu</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the MCU software version of the built-in cam system. 
MCU SW Version Example
: &quot;0D.00.00.01&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>VehicleModel</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the vehicle model of the built-in cam system. 
Vehicle model Example
: “GN7&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>Manager</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>BltnCam</SHORT-NAME>
                  <SYMBOL>BltnCam</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ParkingEvent</SHORT-NAME>
                  <SYMBOL>ParkingEvent</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Manager</SHORT-NAME>
                  <SYMBOL>Manager</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>3</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>PEVInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides metadata for recorded parking event video and its status.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/PEVInfo_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>PEVOprableTime</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provide operating time of the parking event monitoring functionality.
The value table for (Prk_Oprable_Time, Prk_Oprable_Time_Max) is as follows.  -0x00~0xFB: the hours of Park Mode Operatable  -0xFC: Park Mode is not set. (Aux. Bat. Is connected)  -0xFD: Auxiliary Battery is not connected. Auxiliary Battery applicable on this vehicle model.  -0xFE: Auxiliary Battery is not connected. Auxiliary Battery not applicable on this vehicle model.  -0xFF: Invalid</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/PrkOprableTime</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>FinishTransmitting</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Notifies that the transmission of the corresponding parking event video has been completed.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>eventID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RequestError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RequestFile</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Request to Download the recorded parking event video with hash code and file name.  It is provided after being encoded in the  optimized format for smartphone requirement.  Information of Thumbnail (or video) is requested and responsed asynchronously</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>eventID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>fileName</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RequestError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>size</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>blob</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteArray</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>Manager2</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>CCU</SHORT-NAME>
                  <SYMBOL>CCU</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>ExternalNetwork</SHORT-NAME>
                  <SYMBOL>ExternalNetwork</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Manager2</SHORT-NAME>
                  <SYMBOL>Manager2</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>1</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>Activity</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">PE 1 second. 	This signal indicates a change in the counter values for the service groups. It is updated once a second and if it is same as previous value, it is not updated. 	rx_bytes : Total bytes received per service group. 	tx_bytes : Total bytes sent per service group.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Activity_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ServiceGroups</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Gets the all Service Group's list and its property on the system.

Description of String grouptype

&quot;DEFAULT&quot; : SERVICE_GROUP_DEFAULT
&quot;CCS&quot; : SERVICE_GROUP_CCS
&quot;FOTA&quot; : SERVICE_GROUP_FOTA
&quot;USERPAID&quot; : SERVICE_GROUP_USERPAID
&quot;OEMPAID&quot; : SERVICE_GROUP_OEMPAID
&quot;STREAMING_STANDARD&quot; : SERVICE_GROUP_STREAMING_STANDARD
&quot;STREAMING_PREMIUM&quot; : SERVICE_GROUP_STREAMING_STANDARD
&quot;VCRM&quot; : SERVICE_GROUP_VCRM
&quot;CANIDS&quot; : SERVICE_GROUP_CANIDS

Description of enumeration ConnectionStatus
DISCONNECTED : Associated APN is not activated to the mobile network, or connecting status.
CONNECTED : Associated APN is activated to the mobile network
ONLINE : Verified that the state of the connected network is able to communicate with the remote host.

Description of String endpointtype
&quot;Headunit&quot; : Headunit family such as ccIC and ccNC
&quot;Headunit_RSE&quot; : Standalone Rear Seat Infotainment System such as ccRC
&quot;CCU&quot; : Central Communication Unit

Description of struct EndpointConfiguration[] ipconfig
Network configuration for Endpoint ECU's Source IP network.
Endpoint ECU have to setting up the network environment using IP suitable for EndpointType.

Description of String[] nameservers
IP address of the local in-vehicle dns server (which located in CCU VCC owned) for the EXTNET.
Local nameserver support IPv4, IPv6 together from same DNS instance.
Description of struct ARLTableItem[] ipv4_arl_tables, ipv6_arl_tables
For activate the ARP cache on the endpoint, A pair of MAC addresses and IP addresses are should be provided.
ipv4_arl_tables contains that ipv4 addresses, ipv4 gateway address, nameservers lists for ipv4.
ipv6_arl_tables contains that ipv6 addresses, ipv6 gateway address, nameservers lists for ipv6.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ServiceGroups_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>TetheringService</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO"> Gets the Tethering Service property on the VCC system. 	Description of enumeration ConnectionStatus 	-DISCONNECTED : Associated APN (for tethering) is not activated to the mobile network, or connecting status. 	-CONNECTED : Associated APN (for tethering) is activated to the mobile network 	-ONLINE : Verified that the state of the connected network is able to communicate with the remote host. 	 	Description of EndpointConfiguration[] ipconfig 	-Network configuration for Endpoint ECU's Source IP network. Only support Headunit. 	-Endpoint ECU have to setting up the network environment using IP suitable for EndpointType.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TetheringService</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TetheringActivate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Activate Tethering PDP Context Request</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>result</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TetheringDeactivate</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Deactivate Tethering PDP Context Request</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ContextError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>MapMatching</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Info</SHORT-NAME>
                  <SYMBOL>Info</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Location</SHORT-NAME>
                  <SYMBOL>Location</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>MapMatching</SHORT-NAME>
                  <SYMBOL>MapMatching</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>1</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>MapMatchingData</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">[Periodic Event 1s] Transmit Mapmatching Data of current location information of vehicle. 	-The value of longitude and latitude format is the coordination x 1,000,000 in WGS84 format 	-The value of altitude format is in centimeter (value x 100) 	-The value of speed format is in km/h (KPH) 	-The value of heading between 0.0 ~ 360.0 based on magnetic variation</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MapmatchingData</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>MapMatchingType</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Transmit Mapmatching Type of current location information of vehicle.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/MapmatchingType</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
            </SERVICE-INTERFACE>
