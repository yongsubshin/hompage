                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>MessageManager</SHORT-NAME>
                  <SYMBOL>MessageManager</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>ReceiveMessageAdded</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This event indicates that a new message has been received from the network.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ReceiveMessageAdded_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>ReceiveMessageRemoved</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This event indicates that a message has been removed from the list.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ReceiveMessageRemoved_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>SendMessageResult</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This event informs the result of the message transmission to client.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SendMessageResult_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetAllReceiveMessages</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Get a list of messages being receiving or received.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>item</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/GetAllReceiveMessages_item_VECTOR</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
