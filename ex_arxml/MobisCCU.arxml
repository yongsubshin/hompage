            <SERVICE-INTERFACE>
              <SHORT-NAME>IVPA</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Vehicle</SHORT-NAME>
                  <SYMBOL>Vehicle</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Security</SHORT-NAME>
                  <SYMBOL>Security</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>IVPA</SHORT-NAME>
                  <SYMBOL>IVPA</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RequestDID</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">SDE에서 IVPA로 DID 요청 메시지 전달 및 응답 전달
isRDBI True : Read Data / False : Write Data</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>requestData</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteArray</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>requestDataLen</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>isRDBI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/bool</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>err</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ErrCode</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>responseData</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteArray</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>responseDataLen</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RequestRID</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">SDE에서 IVPA로 RID 요청 메시지 전달 및 응답 전달</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>requestData</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteArray</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>requestDataLen</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>err</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ErrCode</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>responseData</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ByteArray</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>responseDataLen</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>InformationProvider</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Info</SHORT-NAME>
                  <SYMBOL>Info</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Cluster</SHORT-NAME>
                  <SYMBOL>Cluster</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>InformationProvider</SHORT-NAME>
                  <SYMBOL>InformationProvider</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>4</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>AverageFuelEconomy</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the average fuel economy of the vehicle.
    The Average Fuel Economy Type is:
    - Drive : The data provided by vehicle driving cycle.
    - AfterRefuel : The data calculated from after refueling.
    - Accumulated : The data that provides cumulative.
    - Term : The data calculated every 2.5 minutes.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/AverageFuelEconomy_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>AverageFuelEconomyStr</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the average fuel economy of the vehicle.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/AverageFuelEconomyStr_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>DTE</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the remaining mileage of the vehicle.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/DTEInfo</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>DTEStr</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the remaining mileage of the vehicle.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/DistanceStrInfo</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>DrivingModes</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides the list of selected driving mode and selectable driving modes in the cluster.
-There is only one selected item in the list.
-Driving modes that are not supported by the cluster are not included in the list.
-And if the driving mode selection is not supported, an empty list is displayed.

Below is a reference to the driving mode list. For more detail information, please refer to the ES specification.
-ECO
-NORMAL(COMFORT)
-SPORT
-SMART
-MY_DRIVE
-CUSTOM_SNOWT
-TERRAIN_SNOW
-TERRAIN_MUD
-TERRAIN_SAND
-TERRAIN_AUTO
-TERRAIN_DEEP_SNOW
-N
-N_CUSTOM1
-N_CUSTOM2</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/DrivingModes_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>DynamicModePopupInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Inform the pop up information related dynamic mode control</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>FuelStatusInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This interface indicates that the current fuel level values in % and low fuel warning status

FuelLevel indicates that fuel level value in % for a vehicle.

LowFuelStatus indicates that current low fuel warning stats for a vehicle.

depending on fuel level and fuel status LowFuelStatus has a string value below.

low fuel level - LowFuelStatus: &quot;LOW_LEVEL&quot;

calculation error - LowFuelStatus: &quot;ERROR&quot;

other case - LowFuelStatus: &quot;OFF&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/FuelStatusInfo</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>JourneyDistance</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the distance information of the vehicle.
    The Journey Distance Type is:
    - Drive : The data provided by vehicle driving cycle.
    - AfterRefuel : The data calculated from after refueling.
    - Accumulated : The data that provides cumulative.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/JourneyDistance_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>JourneyDistanceStr</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the distance information of the vehicle.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/JourneyDistanceStr_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>JourneyTime</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the driving period information of the vehicle.
    The Journey Time Type is:
    - Drive : The data provided by vehicle driving cycle.
    - AfterRefuel : The data calculated from after refueling.
    - Accumulated : The data that provides cumulative.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/JourneyTime_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>LanguageStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides current language status of the cluster.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/LanguageStatusInfo</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>PreviousTripInformation</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Driving Information from the time of reset to the last drving end point</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/PreviousTripInfo</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ProviderOptions</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates a list of features that supported by the cluster information provider.
The ProviderOptions will inform that whether it is &quot;Support&quot;/&quot;NotSupport&quot; for the following items.
-DTE
-AverageFuelEconomy
-JourneyDistance 
-JourneyTime 
-Telltale
-DrivingModes</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SpeedUnitDefault</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">It is used to give default speed unit value to HU for judging speed unit before area data input
It has same information with CLU_SpdUnitTyp_Def_MM(MM-CAN)
Data is written as decimal value which match the hex value of the CAN DB
Descriptions for DisplaySpeedDefaultUnit

Factor of signal is 1
Offset of signal is 0

0:Default
1:kph,kmph
2:mph
3:Invalid</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Telltale</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides a list of the cluster's warning lights and it's status as a service.
    Below is a reference to the DID list. And the status code may vary for each node. For more detail information, please refer to the ES specification.
    - &quot;4WDDIAG&quot;, &quot;ABS&quot;, &quot;AFS&quot;, &quot;AIRBAG&quot;, &quot;AUTO_HOLD&quot;, &quot;AWDLOCK&quot;, &quot;BATTERY_CHARGE&quot;, &quot;CHECK_ENGINE&quot;, &quot;DBC_LIMOUSINE&quot;, &quot;DBC_SEDAN&quot;, &quot;DMS&quot;, &quot;DPFGPF&quot;, &quot;DRIFT_MODE&quot;, &quot;ECALL&quot;, &quot;ECC&quot;, &quot;ECC_CHINA&quot;, &quot;EPB&quot;, &quot;ESC&quot;, &quot;ESC_OFF&quot;, &quot;FCA&quot;, &quot;HBA&quot;, &quot;HDA2&quot;, &quot;HIGHBEAM&quot;, &quot;ICEWARNING&quot;, &quot;IMMOBILIZER_SEDAN&quot;, &quot;IPEDAL&quot;, &quot;ISG&quot;, &quot;LDWLKA&quot;, &quot;LEDLAMPFAIL&quot;, &quot;LFAHDA&quot;, &quot;LOWBATTERY&quot;, &quot;LOWBEAM&quot;, &quot;LOWFUELWARN&quot;, &quot;MASTERSYMBOL&quot;, &quot;MDPS&quot;, &quot;OILPRESS&quot;, &quot;OVERSPEEDWARN&quot;, &quot;PARKING_BRAKE&quot;, &quot;POWERDOWN&quot;, &quot;RBS&quot;, &quot;READY&quot;, &quot;REARFOG&quot;, &quot;RSBR_CENTER&quot;, &quot;RSBR_LEFT&quot;, &quot;RSBR_RIGHT&quot;, &quot;SEATBELT&quot;, &quot;SERVICE&quot;, &quot;SERVICE_CHINA&quot;, &quot;TAILLAMP&quot;, &quot;TPMS&quot;, &quot;TPMS_CHINA&quot;, &quot;TURNSIGNAL&quot;, &quot;UTIL_MODE&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Telltale_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>TripRawData</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the total accumulated driving history data calculated in the cluster.

The Key data as follows:

Distance 
FuelConsumption (Not used)
HydrogenConsumption (Not used)
EletricityConsumption (Not used)
 
The units of value data mapped to each key are as follows:

Distance : km
FuelConsumption : l
HydrogenConsumption : kg
EletricityConsumption : kwh</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueFloat</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SetDrivingMode</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Set the driving mode you want to change.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>desireMode</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TermAverageFuelEconomyReset</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Request to reset 2.5 minute fuel economy data</L-2>
                  </DESC>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>InteractionManager</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Info</SHORT-NAME>
                  <SYMBOL>Info</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Update</SHORT-NAME>
                  <SYMBOL>Update</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>InteractionManager</SHORT-NAME>
                  <SYMBOL>InteractionManager</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>2</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>InteractionContents</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field contains content items for performing user interactions regarding update consent and update progress.

The contents information passed through the Method RequestInteractionUI is updated in this field.

- Key: Update Information Key
- Value: The message to be displayed
For detailed Key-Value items definition of InteractionContents, please refer to the ES specification and UX specification.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueMap</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>InteractionReady</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field indicates the state in which AVNT can display the screen.
(This Field use the same purpose as  OTAUIStatus in CAN DB)

&quot;0&quot; : Not ready
&quot;1&quot; : Ready</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>RequestUpdateInfoToCCU</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field is used for Headunit to request action from the CCU.
The value of this field can be set as one of the key values in UpdateInfoMap.
When the method TransferUpdateInfoValue is completed, the value of the field is set to &quot;&quot;.

&quot;UpdateCheck&quot; : Request UpdateCheck.
&quot;OTAReset&quot; :  Request OTA reset to CCU.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ScheduleUpdateMap</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This Field is used for the purpose of managing sheduled update information in HeadUnit.
The information includes the activating of scheduled update status and scheduled update time information.

The list of keys defined in the KeyValueMap props is as follows:

&quot;IsUpdateScheduled&quot; : TRUE/FALSE 
&quot;ScheduledUpdateTime&quot; : &quot;YYMMDDhhmm&quot; (ex, &quot;2504071310&quot;)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueMap</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ScreenIndex</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field contains content items for performing user interactions regarding update consent and update progress.

The ScreenIndex information passed through the Method RequestInteractionUI is updated in this field.

For detailed value item definition of ScreenIndex, please refer to the ES specification and UX specification.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SettingsContents</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field contains the content items necessary for the composition of the Software Update information menu under the General Settings menu.

The contents information passed through the Method UpdateSettingsContentsMap is updated in this field.

- Key: Update Information Key
- Value: The message to be displayed
For detailed Key-Value items definition of SettingsContents, please refer to the ES specification and UX specification.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueMap</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SoftwareReleaseApprovals</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field contains the results of user interactions such as their agreement to download and install the software release items.

When an item in the Field SoftwareReleaseLists is added/deleted, the items in this field will also be added/deleted accordingly. However, when a new item is added, the user has not agreed yet, so the String ReleaseID is valid but the contents of the KeyValueMap prop for the item are empty.

ReleaseID is a unique identifier for the software release expressed as a string.

The list of keys defined in the KeyValueMap props is as follows:
1. &quot;download&quot; : contains the information of the user's agreement to download.
&quot;OK&quot; / &quot;NOK&quot; / &quot;LATER&quot; / &quot;UNRECOGNIZED_REJECT
2. &quot;install&quot;: contains the information of the user's agreement to install.
&quot;OK&quot; / &quot;NOK&quot; / &quot;LATER&quot; / &quot;UNRECOGNIZED_REJECT&quot;
3. &quot;donotshowagain&quot;: contains the user's preference not to show again.
&quot;TRUE&quot; / &quot;FALSE&quot;
4. &quot;reason&quot;: contains the information of unrecongnized reject reason.
001 : Valet mode
002 : Force Update
003 : AVNT OTA
004 : Power State Change (ACC ON, IGN ON)
005 : ADM logic off
006 : Screen Transition
007 : SOS Call
008 : SVR (Stolen Vehicle Recovery)
009 : ACN Call (Automated Collision Notification)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SoftwareReleaseApprovals_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SoftwareReleaseLists</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field contains information about the software release for the controller update service. The contents of the field can be added or changed through the Method UpdateReleaseInfo, and deleted through the Method DeleteReleaseInfo.

ReleaseID is a unique identifier for the software release expressed as a string.

The list of keys defined in the KeyValueMap props is as follows:
1. &quot;UpdateState&quot;: Indicates the status of a software release
The value of the &quot;UpdateState&quot; key is as follows:
- &quot;NewUpdate&quot;: The state of receiving new version information and description information from the server
- &quot;DownloadApprovalWaiting&quot;: Display of the download consent popup
- &quot;DownloadReady&quot;: Approval of downloading by agreeing
- &quot;Downloading&quot;: Download in progress
- &quot;DownloadDone&quot;: Download complete
- &quot;BackgroundTransferring&quot;: Background transfer in progress
- &quot;BackgroundTransferDone&quot;: Background transfer complete
- &quot;UpdateApprovalWaiting&quot;: Display of the update consent popup
- &quot;UpdateReady&quot;: Approval of update by agreeing
- &quot;Updating&quot;: Update in progress
- &quot;UpdateCanceled&quot; : Update is canceled
- &quot;UpdateDone&quot;: Update complete (including rollback/failure)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SoftwareReleaseLists_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>UpdateInfoMap</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This Field is used for the purpose of managing update information in HeadUnit.
The information includes the update status and broadcasting to CCU when the update status is changed.
The list of keys defined in the KeyValueMap props is as follows:
- &quot;CCUUIVersion&quot; : Current version infomation of the CCU update software.
- &quot;HeadUnitUIVersion&quot; : Current version infomation of the Headunit update software.
- &quot;SourceEventVersion&quot; :  Current Vehicle version information.
- &quot;UpdateCheck&quot; : Value ranges from &quot;C1&quot;~&quot;C7&quot;. For detailed information, refer to the specification.
- &quot;HeadUnitPlatform&quot; : &quot;ccNC&quot; / &quot;ccNC_Basic&quot; / &quot;ccIC&quot; / &quot;ccIC27&quot; / &quot;PI&quot; / &quot;CW&quot; / &quot;CS&quot; / &quot;CL&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueMap</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>DeleteReleaseInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method is used when the consumer wants to delete the information about the software release for the controller update to the producer.

The result of the addition or modification is immediately reflected in the Field SoftwareReleaseLists and SoftwareReleaseApprovals, which are received by the producer.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>ReleaseID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>InitializeInteractionUI</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This Method is used to clear the screen requested by &quot;RequestInteractionUI&quot;.
In response to this request, the producer clear the displayed screen  in AVNT and return result.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RequestInteractionUI</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method is used to request the display of a screen for the interaction of the controller update service, and to update the display content. The items defined in the KeyValueMap NewContents will be added or updated, while the keys that are not defined will be immediately deleted from the Field InteractionContents.

ScreenIndex is the screen index value that you want to display. The interaction screen will be configured based on the layout and scenario defined for the corresponding screen index.
- &quot;ScreenIndex&quot;: (ex) &quot;R001&quot;, for detailed display format, please refer to the ES specification.
- &quot;ReleaseIDList&quot; is a list of Software Release IDs associated with the screen index for display purposes.
The detailed Key-Value item definition of KeyValueMap NewContents can be found in the ES specification and UX specification.

The errorReason item is returned when it is difficult to perform a proper request.
- &quot;errorReason&quot;: (ex,) &quot;001&quot;, &quot;002&quot;, for detailed specifications, please refer to the ES specification.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>ReleaseIDList</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RequestInteractionUI_ReleaseIDList_VECTOR</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>ScreenIndex</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>NewContents</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueMap</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>errorReason</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RequestKeepScreenOn</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method is used to request that the screen be maintained in an IGN OFF situation to proceed with CCU update.
In response to this update request, the creator does not exit the screen in the IGN OFF situation,
Hold and wait for CCU's RequestInteractionUI request.
When the requester no longer needs to hold the screen, the method can be called back and it passes the FALSE value.

&quot;TRUE&quot; : Keep screen
&quot;FALSE&quot; : Do not keep screen</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>KeepScreenOn</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferUpdateInfoValue</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method is used for the purpose of delivering the UpdateInfoMap.
When the value of the RequestUpdateInfoToCCU changes, 
CCU will pass the requested key and the corresponding value as arguments through the TransferUpdateInfoValue method.

- &quot;CCUUIVersion&quot; : Current version infomation of the CCU update software.
- &quot;SourceEventVersion&quot; :  Current Vehicle version information.
- &quot;UpdateCheck&quot; : Value ranges from &quot;C1&quot;~&quot;C7&quot;. For detailed information, refer to the specification.
- &quot;OTAReset&quot; :  &quot;START&quot;/&quot;COMPLETE&quot;</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>KeyInfo</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>ValueInfo</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferWhatsNewContents</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This Method is used by the CCU to transfer What's new content to HU.
For this request, the producer saves What's new content as a file and displays it according to the update scenario.
The transmitted what's new contents must contain all languages.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>AllContents</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferWhatsNewContents_AllContents_VECTOR</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>TransferWhatsNewContentsCCUApp</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This Method is used by the CCU to transfer CCU App What's new content to HU.
For this request, the producer saves What's new content as a file and displays it according to the update scenario.
The transmitted what's new contents must contain all languages.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>AllContents</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/TransferWhatsNewContentsCCUApp_AllContents_VECTOR</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>UpdateReleaseInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method is used when the consumer wants to add or modify the information about the software release for the controller update to the producer.

The result of the addition or modification is immediately reflected in the Field SoftwareReleaseLists and SoftwareReleaseApprovals, which are received by the producer.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>ReleaseID</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>NewState</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>UpdateSettingsContentsMap</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method updates the software release information displayed to the user through the General Settings menu.

In response to this update request, the producer replaces the list of items defined in the Field SettingsContents with the defined list of items in the Field SettingsContents. However, if a Key is not defined, it means deletion, and it is immediately deleted from the Field SettingsContents.

- Key: Update Information Key
- Value: The message to be displayed
For detailed Key-Value item definitions of Field SettingsContents, please refer to the ES specification and UX specification.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>NewContents</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueMap</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
