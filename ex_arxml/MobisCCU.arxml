              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>4</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>AVNVersion</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the vehicle OTA HMI scenario version that applied to the AVN(Headunit).</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>CCUVersion</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Indicates the vehicle OTA service scenario version that applied to the CCU(Gateway).</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
