                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/ConditionNotCorrect</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidFilePath</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                    <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/PortInterface/Service/ErrorDomain/PackageInconsistent</POSSIBLE-AP-ERROR-REF>
