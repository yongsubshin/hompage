            <SERVICE-INTERFACE>
              <SHORT-NAME>Variant</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Info</SHORT-NAME>
                  <SYMBOL>Info</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>System</SHORT-NAME>
                  <SYMBOL>System</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Variant</SHORT-NAME>
                  <SYMBOL>Variant</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>7</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>Variants</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides a list of variant infomations to an external system. 
The Key-Value table follows the specification for each item.
Provides the list of variant infomations below to an external system.
- CAR_CODE : &quot;GN7&quot;
- GENERAL_REGION : &quot;KOR&quot;
- SYSTEM_MAIN_SW_VER : Follows the version notation specification.
- PLATFORM_TYPE : {&quot;PG6&quot;, &quot;CCIC&quot;, &quot;CCNC&quot;}
- CAR_BRAND : {&quot;HYUNDAI&quot;, &quot;KIA&quot;, &quot;GENESIS&quot;}
- NAVIGATION : {&quot;TRUE&quot;, &quot;FALSE&quot;}
- DRIVE_TYPE: {&quot;LEFT&quot;, &quot;RIGHT&quot;}
- VEHICLE_PACKAGE: {&quot;SPORTS&quot;, &quot;SPORTY&quot;, &quot;STANDARD&quot;}
- RRC: {&quot;TRUE&quot;, &quot;FALSE&quot;}
- FUEL_TYPE: {&quot;GASOLINE&quot;, &quot;DIESEL&quot;, &quot;LPI&quot;}
- EV_TYPE: {&quot;ICE&quot;, &quot;HEV&quot;, &quot;PHEV&quot;, &quot;EV&quot;, &quot;FCEV&quot;}
- ECALL: {&quot;TRUE&quot;, &quot;FALSE&quot;}
- RVM_SVM: {&quot;NONE&quot;, &quot;RVM&quot;, &quot;SVM&quot;}
- BODY_TYPE: {&quot;SEDAN&quot;, &quot;SUV&quot;, &quot;MPV&quot;, &quot;WAGON&quot;, &quot;HACHBACK&quot;, &quot;OPENBED&quot;, &quot;TRUCK&quot;, &quot;BUS&quot;, “LIMOUSINE”}
- CCS: {&quot;TRUE&quot;, &quot;FALSE&quot;}
- N_MODE: {&quot;TRUE&quot;, &quot;FALSE&quot;}
- BT_NAME: Set the vehicle name according to the Bluetooth connection display name specification of the front seat
- AMP_TYPE: {&quot;INTERNAL_AMP&quot;, &quot;EXTERNAL_AMP&quot;}
- BLACK_LINE: {&quot;TRUE&quot;, &quot;FALSE&quot;}
- CCRC_TYPE: { &quot;CCRC1&quot;, &quot;CCRC2&quot;}
- CCS_TYPE: { &quot;CCS1&quot;, &quot;CCS2&quot;}</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>Variation</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>DCU</SHORT-NAME>
                  <SYMBOL>DCU</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>System</SHORT-NAME>
                  <SYMBOL>System</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Variation</SHORT-NAME>
                  <SYMBOL>Variation</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>3</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>GetVariation</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Service interface to get a variation of DCU will be
    provided by DCU, and CCU can be aware of the variation by consuming it.
    If the regions for which no function is provided in DCU,
    such as ECALL or NEMS, return empty array results.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/VarError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>var</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/VariationInfo</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>VehicleAPI</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Vehicle</SHORT-NAME>
                  <SYMBOL>Vehicle</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>VAS</SHORT-NAME>
                  <SYMBOL>VAS</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>VehicleAPI</SHORT-NAME>
                  <SYMBOL>VehicleAPI</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>1</MINOR-VERSION>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>Subscription_1</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">The event occurs for paths that have been subscribed to through the Subscribe_1 method.

The number that follows is assigned per consumer unit.

subscriptionId should be greater  than 0.

Array's or Struct's value will be passed in Json format.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Subscription_1_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>CheckAvailability</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Only one path  can be requested.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>path</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>statusCode</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int16_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>availability</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Availability</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Read</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Only one path  can be requested. Array and Struct type is not supported.
Filter is not supported.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>path</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>statusCode</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int16_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>value</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Subscribe_1</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Paths filter is supported for mass subscription. Only available signals will be processed.
subscriptionId should be greater  than 0.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>path</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>pathsFilter</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Subscribe_1_pathsFilter_VECTOR</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>statusCode</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int16_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>subscriptionId</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int64_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Unsubscribe_1</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This method can only handle unsubscribe requests for subscriptions made through the Subscribe_1 method.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>subscriptionId</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int64_t</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>statusCode</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int16_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Update</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Only one path  can be requested. Array and Struct type is not supported.</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>path</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>value</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>statusCode</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/int16_t</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>VoiceCallManager</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>DCU</SHORT-NAME>
                  <SYMBOL>DCU</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Telephony</SHORT-NAME>
                  <SYMBOL>Telephony</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>VoiceCallManager</SHORT-NAME>
                  <SYMBOL>VoiceCallManager</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>2</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <EVENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>RecvTones</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Receive the DTMF tones from the network.
     - tonePress: Press = 1, Release = 0</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/RecvTones_EventData</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EVENTS>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>CallSession</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Gets the properties of the ongoing or last voice call object.
                  DisconnectReason field is only filled when VoiceCallStatus::Disconnected</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/VoiceCallSession</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Answer</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Answers the incoming call. Only valid if the state of the call is &quot;incoming.&quot;</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>cid</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/CallError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>Dial</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Initiates a new outgoing call.</L-2>
                  </DESC>
                  <ARGUMENTS>
