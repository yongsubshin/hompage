                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>key</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/NumValueKey</TYPE-TREF>
