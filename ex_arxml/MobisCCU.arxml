              <FIELDS>
                <FIELD>
                  <SHORT-NAME>LocationUTCTime</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">[Periodic 1000ms] GNSS-based UTC time information is notified to subscribers in 1000ms periodic message.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/LocationTime</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
