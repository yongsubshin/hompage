                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>0</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>DGPSAge</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This property indicates the elapsed time since from DGPS time to current time(in seconds). 	- DGPSAge = 0 - 254 : age in seconds, 255 : overage or invalid</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>DOP</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field indicates the GNSS Dilution of Prevention (DOP) values.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/DOP</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>FixStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This property indicates the GNSS fix status. 	- FixStatus = 	0x00 : Doing position fixes, 	0x02 : Need time, 	0x03 : PDOP too high, 	0x05 : No usable SVs, 	0x06 : One usable SV, 	0x07 : Two Usable SVs, 	0x08 : Three Usable SVs.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>LocationAccuracy</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Location Accuracy.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/LocationAccuracyData</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>LocationFix</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Location Fix Status. 	- fix_source(0 = No Fix, 17 = Fix Valid) 	- fix_2D_indicator : Field valid only if Fix Source is 17(0 = 3D Fix, 1 = 2D Fix)</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/LocationFixData</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>LocationGNSSData</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">[Periodic Event 200ms] Location GNSS Data  This field is periodically updated every 200ms.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/LocationData</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>LocationStatus</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This function will be invoked when the location status infomation is changed.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/LocationStatusData</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SVCount</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Number of Visible SV(Space Vehicle)s Counts</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>SearchMode</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This property indicates the health status of GPS. 	- SearchMode = 	0 : None, 	1 : Blind, 	2 : Anywhere.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint8_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Validity</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field indicates for Validity Bitmap with GNSS validity flags.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/uint32_t</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>ValidityError</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">This field indicates GNSS error statistics. The value of Validity bitsmap is a combination of the values below. 	- latitude_error : The error of latitude. Standard deviation of latitude error (1 sigma). unit : m 	- longitude_error : The error of longitude. Standard deviation of longitude error (1 sigma). unit : m 	- altitude_error : The error of altitude. Standard deviation of altitude error (1 sigma). unit : m 	- horizontalSpeed_error : The error of horizontal speed. Standard deviation of horizontal speed error (1 sigma). unit : m/s 	- verticalSpeed_error : The error of vertical speed. Standard deviation of vertical speed error (1 sigma). unit : m/s 	- heading_error : The error of heading. Standard deviation of heading error (1 sigma). unit : deg</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/ValidityError</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
            </SERVICE-INTERFACE>
            <SERVICE-INTERFACE>
              <SHORT-NAME>GeneralSettings</SHORT-NAME>
              <NAMESPACES>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Info</SHORT-NAME>
                  <SYMBOL>Info</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>Setup</SHORT-NAME>
                  <SYMBOL>Setup</SYMBOL>
                </SYMBOL-PROPS>
                <SYMBOL-PROPS>
                  <SHORT-NAME>GeneralSettings</SHORT-NAME>
                  <SYMBOL>GeneralSettings</SYMBOL>
                </SYMBOL-PROPS>
              </NAMESPACES>
              <MAJOR-VERSION>1</MAJOR-VERSION>
              <MINOR-VERSION>9</MINOR-VERSION>
              <FIELDS>
                <FIELD>
                  <SHORT-NAME>AvailableLanguages</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides a list of user selectable languages to an external system.
The values are cast to Int32 and sent.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/AvailableLanguages_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>GeneralSettings</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides a list of general settings to an external system.
The Key-Value table follows the specification for each item.
Provides the list of general settings below to an external system.
LanguageType: value list references the enum class ccos::HLanguageType.
DefaultLanguageType: value references the default setting from the enum class ccos::HLanguageType. The typical value is US_ENGLISH..
DistanceUnit: value list references theenum class  ccos::HDistanceUnit.
TemperatureUnit: value list references the enum class  ccos::HTemperatureUnit.
TimeFormat: value list references the enum class ccos::clock::HDateFormatType.
FontSize: value list references the ccos::system::HFontSize.
KnobType: An enum representing the type of knob, with options for NOT_SUPPORT=0, SINGLE_KNOB_TYPE_VOLUME=1, SINGLE_KNOB_TYPE_TUNE=2, DUAL_KNOB_TYPE_VOLUME=3, DUAL_KNOB_TYPE_TUNE=4, and INVALID=5.
NaviVolumeControlSetting : An enum representing the setting of navigation volume control with options for VOLUME_BUTTON_IN_MAP = 0, VOLUME_BUTTON_IN_MAP_AND_VOLUME_KNOB = 1.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValue</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>RearGeneralSettings</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides a list of general settings of the rear seat system.
The Key-Value table follows the specification for each item.
Provides the list of general settings below to an external system.
- &quot;NetworkSubscribeState&quot;
- &quot;SIMState&quot;</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueString</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>Themes</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides a list of themes available in the system.
Allowed keys for each theme:
- &quot;ThemeName&quot;: Represents the name of the theme.
- &quot;Activate&quot;: Indicates whether the theme is active or not. It can be either &quot;TRUE&quot; or &quot;FALSE&quot;.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/Themes_VECTOR</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
                <FIELD>
                  <SHORT-NAME>VersionInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Provides a list of system version information to an external system.
The Key-Value table follows the specification for each item.
Provides the list of general settings below to an external system.
&quot;SYSTEM_MAIN_SW_VER&quot;
&quot;CLU_AP_SW_VER&quot;
&quot;CLU_MCU_SW_VER&quot;
&quot;HUD_SW_VER&quot;
&quot;CCRC_SW_VER&quot;
&quot;BLTN_CAM_SW_VER&quot;
&quot;CCUAPP_{APP_NAME}_SW_VER&quot;

The CCU APP version displays the {APP_NAME} variable as its name.
If the sw_Version field is &quot;&quot;, delete the corresponding {APP_NAME} from the version information.</L-2>
                  </DESC>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/KeyValueString</TYPE-TREF>
                  <HAS-GETTER>true</HAS-GETTER>
                  <HAS-NOTIFIER>true</HAS-NOTIFIER>
                  <HAS-SETTER>false</HAS-SETTER>
                </FIELD>
              </FIELDS>
              <METHODS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SetRearGeneralSettings</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Collects the general settings status of the rear seat system.
The KeyItem is allowed to use the keyword in the list below. For more specifications, contact your vehicle specification reponsible.
- &quot;NetworkSubscribeState&quot;
- &quot;SIMState&quot;</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>keyItem</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>valueItem</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SetVersionInfo</SHORT-NAME>
                  <DESC>
                    <L-2 L="KO">Collect controller software versions that belong to the infotainment domain.
The unit is allowed to use the keyword in the list below. 
For more specifications, contact your vehicle specification reponsible.
&quot;CLU_AP_SW_VER&quot;
&quot;CLU_MCU_SW_VER&quot;
&quot;HUD_SW_VER&quot;
&quot;CCRC_SW_VER&quot;
&quot;BLTN_CAM_SW_VER&quot;</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>unit</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>sw_Version</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/String</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>error_of_CommonAPI</SHORT-NAME>
                      <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/DataType/Implementation/CPP/SetError</TYPE-TREF>
                      <DIRECTION>OUT</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                </CLIENT-SERVER-OPERATION>
              </METHODS>
            </SERVICE-INTERFACE>
